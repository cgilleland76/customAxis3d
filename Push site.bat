@echo off
REM Commit, stamp a build version, and push. Netlify builds on push.
cd /d "%~dp0"
title Axis3D - push site

if exist ".git\index.lock" del /q ".git\index.lock"

REM Stamp the build time and short commit ref into the footer badge, so you can
REM tell at a glance whether what you are looking at is what you last pushed.
for /f %%i in ('git rev-parse --short HEAD 2^>nul') do set REF=%%i
if "%REF%"=="" set REF=local
for /f %%i in ('powershell -NoProfile -Command "(Get-Date).ToUniversalTime().ToString('yyyy-MM-dd HH:mm')"') do set NOW=%%i %%j
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-Date).ToUniversalTime().ToString('yyyy-MM-dd HH:mm')"') do set NOW=%%i

> assets\js\version.js echo /* Regenerated by "Push site.bat" on every push. Do not edit by hand. */
>> assets\js\version.js echo window.APP_BUILD = { at: '%NOW% UTC', ref: '%REF%' };

git add -A
git diff --cached --quiet
if not errorlevel 1 (
  echo.
  echo   Nothing to push - everything is already committed.
  echo.
  pause
  exit /b 0
)

echo.
echo   Build stamp: %NOW% UTC
echo   About to commit:
git diff --cached --stat
echo.
set /p MSG="  Describe the change (Enter for a default): "
if "%MSG%"=="" set MSG=Update site

git commit -m "%MSG%"
git push
if errorlevel 1 (
  echo.
  echo   Push failed. If it mentions authentication, sign in to GitHub and retry.
) else (
  echo.
  echo   Pushed. Netlify rebuilds in a minute or two.
  echo   Hard-refresh with Ctrl+Shift+R, then check the footer reads:
  echo     %NOW% UTC
)
echo.
pause
